<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8">
    <title>Lista de categorias</title>
 
</head>

<%- include('../partials/layout') %>
<body> 
    <div class="container mt-5">
        <div class="glass-card">
            <h1>Lista de categorias</h1>
            
            <a href="/categories/create" class="btn border">Nova categoria</a>
            
            <a href="/admin/dashboard" class="btn border">Voltar</a>
            <hr>

            <% if (categories.length === 0) { %>
                <p>Ainda não existem categorias</p>
            <% } else { %>
                
                <table class="table table-borderless">
                    <tbody>
                        <% categories.forEach(cat => { %>
                            <tr>
                                <td><strong><%= cat.name %></strong></td>

                                <td>
                                    <a href="/categories/edit/<%= cat._id %>" class="btn border">Editar</a>
                                    
                                    <form action="/categories/delete/<%= cat._id %>" method="POST" class="d-inline">
                                        <button type="submit" class="btn border">Apagar</button>
                                    </form>

                                    <a href="/categories/<%= cat._id %>" class="btn border btn-glass">Detalhes</a>
                                </td>
                                
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

            <% } %> 
        </div>  
    </div>
</body>
</html>