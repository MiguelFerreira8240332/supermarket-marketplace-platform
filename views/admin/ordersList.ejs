<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8">
    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
    <title>Gestão de encomendas</title>
</head>
<%- include('../partials/layout') %>

<body class="container mt-5">
    <div class="glass-card p-4">
        <h1>Gestão de encomendas</h1>
        <hr>

        <div class="mb-4 bg-light p-3 rounded border">
            <form action="/admin/orders" method="GET" class="row g-3 align-items-end">
                
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Supermercado:</label>
                    <select name="supermarketId" id="select-market" class="form-select" placeholder="Escreve para pesquisar...">
                        <option value="">-- Todos os Supermercados --</option>
                        <% supermarkets.forEach(market => { %>
                            <option value="<%= market._id %>" 
                                <%= selectedMarket == market._id.toString() ? 'selected' : '' %>>
                                <%= market.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold">Estado da Encomenda:</label>
                    <select name="status" class="form-select">
                        <option value="">-- Todos os Estados --</option>
                        <option value="Pendente" <%= selectedStatus == 'Pendente' ? 'selected' : '' %>>Pendente</option>
                        <option value="Confirmada" <%= selectedStatus == 'Confirmada' ? 'selected' : '' %>>Confirmada</option>
                        <option value="Em processamento" <%= selectedStatus == 'Em processamento' ? 'selected' : '' %>>Em processamento</option>
                        <option value="Em entrega" <%= selectedStatus == 'Em entrega' ? 'selected' : '' %>>Em entrega</option>
                        <option value="Entregue" <%= selectedStatus == 'Entregue' ? 'selected' : '' %>>Entregue</option>
                        <option value="Cancelada" <%= selectedStatus == 'Cancelada' ? 'selected' : '' %>>Cancelada</option>
                    </select>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <% if (selectedMarket || selectedStatus) { %>
                        <a href="/admin/orders" class="btn btn-outline-secondary">Limpar</a>
                    <% } %>
                    <a href="/admin/dashboard" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>

        <% if (orders.length === 0) { %>
            <div class="alert alert-info">Nenhuma encomenda encontrada.</div>
        <% } else { %>
            <table class="table table-hover align-middle">
                <thead class="table-white">
                    <tr>
                        <th>ID da encomenda</th>
                        <th>Loja</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(order => { %>
                        <tr>
                            <td><small class="text-muted">#<%= order._id.toString().substring(18) %></small></td>
                            <td>
                                <span class="badge bg-secondary">
                                    <%= order.supermarket ? order.supermarket.name : 'N/A' %>
                                </span>
                            </td>
                            <td><%= order.client %></td>
                            <td><strong><%= order.totalValue.toFixed(2) %>€</strong></td>
                            <td>
                                <% 
                                    let badge = 'bg-info';
                                    if(order.status === 'Confirmada') badge = 'bg-success';
                                    if(order.status === 'Cancelada') badge = 'bg-danger';
                                %>
                                <span class="badge <%= badge %>"><%= order.status %></span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>

    <script>
    new TomSelect("#select-market", {
        create: false,
        sortField: {
            field: "text",
            direction: "asc"
        },
        maxOptions: 10
    });
</script>
</body>
</html>