<%- include('../partials/layout') %>

<style>
    .form-label {
        font-weight: bold;
    }
</style>

<body class="container mt-5">

<div class="glass-card p-4">

    <h1>Detalhes do estafeta</h1><br>

    <form action="/courier/settings/<%= courier._id %>" method="POST">

        <!-- name -->
        <label class="form-label">Nome:</label>
        <input type="text" 
               name="name" 
               value="<%= courier.name %>" 
               class="form-control" 
               required>
        <br>

        <!-- email -->
        <label class="form-label">Email:</label>
        <input type="email" 
               name="email" 
               value="<%= courier.email %>" 
               class="form-control" 
               required>
        <br>

        <!-- contact -->
        <label class="form-label">Telefone:</label>
        <input type="text" 
               name="phoneNumber" 
               value="<%= courier.phoneNumber %>" 
               class="form-control">
        <br>

        <!-- address -->
        <label class="form-label">Morada:</label>
        <input type="text" 
               name="address" 
               value="<%= courier.address %>" 
               class="form-control">
        <br>

        <hr>

        <!--botoes -->
        <div class="d-flex justify-content-between align-items-center mt-4">

            <!-- esquerda -->
            <div class="d-flex gap-2">
                <a href="/courier/dashboard" class="btn border">
                    Voltar
                </a>

                <button type="submit" class="btn border">
                    Guardar
                </button>
            </div>

            <!-- direita -->
            <a href="/auth/redefinePW" class="btn border">
                Alterar password
            </a>

        </div>

    </form>

</div>

</body>