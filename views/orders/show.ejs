<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8">
    <title>Detalhes da Encomenda</title>
</head>
<%- include('../partials/layout') %>
<body class="container mt-5">
    <div class="glass-card">
        <div style="display: flex; flex-direction: column; gap: 20px;"> 
            
            <div>
                <h1>Encomenda #<%= order._id %></h1>
                <hr>
                <p><strong>Estado:</strong> 
                    <span class="badge <%= order.status === 'Cancelada' ? 'bg-danger' : 'bg-primary' %>">
                        <%= order.status %>
                    </span>
                </p>
                <p><strong>Data:</strong> <%= order.orderDate ? order.orderDate.toLocaleString() : 'N/A' %></p>
                <p><strong>Tipo de Entrega:</strong> <%= order.deliveryMethod %></p>
                
                <% if (order.deliveryMethod === 'Entrega ao domicilio') { %>
                    <p>
                        <strong>Morada de Entrega:</strong>
                        <% if (order.client && order.client.address) { %>
                            <%= order.client.address %>
                        <% } else { %>
                            <span class="text-danger">Não foi possível encontrar a morada deste cliente.</span>
                        <% } %>
                    </p>
                    <p>
                        <strong>Número de Telemóvel:</strong>
                        <% if (order.client && order.client.phoneNumber) { %>
                            <%= order.client.phoneNumber %>
                        <% } else { %>
                            <span class="text-danger">Não foi possível encontrar o contacto deste cliente.</span>
                        <% } %>
                    </p>
                <% } %>

                <p><strong>Custo de Entrega:</strong> <%= (order.deliveryCost || 0).toFixed(2) %>€</p>
                <p><strong>Valor Total:</strong> <span style="font-size: 1.2em; font-weight: bold;"><%= order.totalValue.toFixed(2) %>€</span></p>
            </div>

            <div>
                <h3>Produtos Encomendados</h3>
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Produto</th>
                            <th>Quantidade</th>
                            <th>Preço Unit.</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (order.products && order.products.length > 0) { %>
                            <% order.products.forEach(item => { %>
                                <tr>
                                    <td><%= item.productId ? item.productId.name : 'Produto não encontrado' %></td>  
                                    <td><%= item.amount %></td>
                                    <td><%= (item.price || 0).toFixed(2) %>€</td> 
                                    <td><%= ((item.amount || 0) * (item.price || 0)).toFixed(2) %>€</td> 
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center">Nenhum produto registado nesta encomenda.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="mt-3" style="display: flex; gap: 10px;">
            <a href="<%= isCourier ? '/courier/dashboard' : '/orders' %>" 
            class="btn border">
                Voltar
            </a>
                            
                <% if (order.status !== 'Cancelada') { %>
                    <form action="/orders/cancel/<%= order._id %>" method="POST" style="display: inline;">
                        <button type="submit" class="btn btn-outline-danger" 
                                onclick="return confirm('Tem a certeza que deseja cancelar?')">
                            Cancelar Encomenda
                        </button>
                    </form>
                <% } %>
            </div>
    
        </div>
    </div>
</body>
</html>